_FALSE, sizeof(float) * 3, 0);", "", "    // ---------- method 1: one global VAO, the layout is set again before every draw", "    unsigned int globalVao;", "    glGenVertexArrays(1, &globalVao);", "    glBindVertexArray(globalVao);", "    glEnableVertexAttribArray(0);", "    glBindVertexArray(0);", "", "    std::string vertexShader =", "        \"#version 330 core\\n\"", "        \"\\n\"", "        \"layout(location = 0) in vec4 position;\\n\"", "        \"uniform vec2 u_Offset;\\n\"", "        \"\\n\"", "        \"void main()\\n\"", "        \"{\\n\"", "        \"    gl_Position = vec4(position.xy + u_Offset, 0.0, 1.0);\\n\"", "        \"}\\n\";", "", "    std::string fragmentShader =", "        \"#version 330 core\\n\"", "        \"\\n\"", "        \"layout(location = 0) out vec4 color;\\n\"", "        \"\\n\"", "        \"uniform vec4 u_Color;\\n\"", "        \"\\n\"", "        \"void main()\\n\"", "        \"{\\n\"", "        \"    color = u_Color;\\n\"", "        \"}\\n\";", "", "    unsigned int shader = CreateShader(vertexShader, fragmentShader);", "    glUseProgram(shader);", "    int colorLocation = glGetUniformLocation(shader, \"u_Color\");", "    int offsetLocation = glGetUniformLocation(shader, \"u_Offset\");", "", "    int frame = 0;", "", "    while (!glfwWindowShouldClose(window))", "    {", "        glClear(GL_COLOR_BUFFER_BIT);", "", "        // left half: method 2, one bind per object", "        glUniform2f(offsetLocation, -0.45f, 0.0f);", "        glBindVertexArray(squareVao);", "        glUniform4f(colorLocation, 1.0f, 0.5f, 0.1f, 1.0f);", "        glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_INT, nullptr);", "        glBindVertexArray(triangleVao);", "        glUniform4f(colorLocation, 0.2f, 0.6f, 1.0f, 1.0f);", "        glDrawArrays(GL_TRIANGLES, 0, 3);", "", "        // right half: method 1, buffer + layout again before each draw", "        glUniform2f(offsetLocation, 0.45f, 0.0f);", "        glBindVertexArray(globalVao);", "        glBindBuffer(GL_ARRAY_BUFFER, squareBuffer);", "        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, sizeof(float) * 2, 0);", "        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, squareIbo);", "        glUniform4f(colorLocation, 1.0f, 0.5f, 0.1f, 1.0f);", "        glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_INT, nullptr);", "        glBindBuffer(GL_ARRAY_BUFFER, triangleBuffer);", "        glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(float) * 3, 0);", "        glUniform4f(colorLocation, 0.2f, 0.6f, 1.0f, 1.0f);", "        glDrawArrays(GL_TRIANGLES, 0, 3);", "", "        if (frame == 0)", "            std::cout << \"frame 0 drawn, glGetError() = \" << glGetError() << std::endl;", "        frame++;", "", "        glfwSwapBuffers(window);", "        glfwPollEvents();", "    }", "", "    glDeleteProgram(shader);", "    glfwTerminate();", "    return 0;", "}", ""], "S": {"4021": {"vao": 1, "abuf": 3, "ebuf": 2, "prog": 1, "size": 2, "stride": 8, "attrbuf": 1, "uni": {"u_Offset": [-0.45, 0], "u_Color": [1, 0.5, 0.1, 1]}, "verts": [[-0.35, -0.35], [0.05, -0.35], [0.05, 0.05], [-0.35, 0.05]]}, "4024": {"vao": 2, "abuf": 3, "ebuf": 0, "prog": 1, "size": 3, "stride": 12, "attrbuf": 3, "uni": {"u_Offset": [-0.45, 0], "u_Color": [0.2, 0.6, 1, 1]}, "verts": [[-0.3, 0.15, 0], [0.3, 0.15, 0], [0, 0.55, 0]]}, "4031": {"vao": 3, "abuf": 1, "ebuf": 2, "prog": 1, "size": 2, "stride": 8, "attrbuf": 1, "uni": {"u_Offset": [0.45, 0], "u_Color": [1, 0.5, 0.1, 1]}, "verts": [[-0.35, -0.35], [0.05, -0.35], [0.05, 0.05], [-0.35, 0.05]]}, "4035": {"vao": 3, "abuf": 3, "ebuf": 2, "prog": 1, "size": 3, "stride": 12, "attrbuf": 3, "uni": {"u_Offset": [0.45, 0], "u_Color": [0.2, 0.6, 1, 1]}, "verts": [[-0.3, 0.15, 0], [0.3, 0.15, 0], [0, 0.55, 0]]}}, "BUG": {"vao": 3, "abuf": 3, "ebuf": 2, "prog": 1, "size": 2, "stride": 8, "attrbuf": 1, "uni": {"u_Offset": [0.45, 0], "u_Color": [0.2, 0.6, 1, 1]}, "verts": [[-0.35, -0.35], [0.05, -0.35], [0.05, 0.05], [-0.35, 0.05]]}, "draws": [[4021, "المربع الشمال